# NetScan AI environment settings
# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# Gemini AI (AI summary of scan results)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. "gemini-flash-latest" always points to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Backend
NODE_ENV=development
PORT=3001
ML_API_URL=http://127.0.0.1:5000

# Threat intel lookups (all optional)
# Free NVD key makes CVE lookups about 10x faster: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Set to "false" to turn off all outside lookups (NVD, CISA KEV, EPSS, Shodan InternetDB)
INTEL_ENABLED=true

# Frontend
VITE_API_URL=http://localhost:3001

# ML API (Python)
# Bind address. Keep 127.0.0.1 unless you really need other machines to reach it.
ML_API_HOST=127.0.0.1
ML_API_PORT=5000
# Network interfaces the capture is allowed to use (comma separated). Empty = any interface tcpdump lists.
ALLOWED_INTERFACES=

# Docker
COMPOSE_PROJECT_NAME=netscan-ai
